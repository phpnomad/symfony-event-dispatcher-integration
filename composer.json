{
    "name": "phpnomad/symfony-event-dispatcher-integration",
    "description": "Integrates PHPNomad's event architecture with Symfony's event dispatcher.",
    "type": "package",
    "homepage": "https://github.com/phoenix/core",
    "readme": "README.md",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "MIT",
    "scripts": {
        "php-cs-fixer": "php-cs-fixer fix"
    },
    "require": {
        "phpnomad/event": "^1.0",
        "phpnomad/di": "^1.0",
        "symfony/event-dispatcher": "^8.0",
        "phpnomad/loader": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PHPNomad\\Symfony\\Component\\EventDispatcherIntegration\\": "lib/"
        }
    },
    "authors": [
        {
            "name": "Alex Standiford",
            "email": "alex@standiford.us"
        }
    ],
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
